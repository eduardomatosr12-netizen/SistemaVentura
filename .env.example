VITE_WHATSAPP_API_KEY=your_whatsapp_api_key
VITE_ASAAS_API_KEY=your_asaas_api_key
# Backend API URL (deixe vazio para usar /api no mesmo domínio)
VITE_API_URL=
# Auth admin (login fixo por email/senha)
VITE_AUTH_EMAIL=seu_email_admin@gmail.com
VITE_AUTH_PASSWORD=sua_senha_admin
# Firebase (Firestore) - apenas para dados, NÃO para autenticação
VITE_FIREBASE_API_KEY=sua-api-key
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=seu-sender-id
VITE_FIREBASE_APP_ID=sua-app-id
# Backend
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=sua-chave-secreta-jwt-aqui
